---
/**
 * Body of a single post page, shared by /posts/[slug] and /en/posts/[slug].
 *
 * Layout: a header (topic, title, lede, date and reading time, TL;DR), then the
 * article beside a sticky outline built from the post's own h2/h3 headings.
 * Below 64rem the outline sits above the article instead. A thin bar at the top
 * of the window shows reading progress, and the outline marks the section in
 * view. Both are enhancements: without JavaScript the outline is still a list
 * of working anchor links.
 *
 * Below the article sit the post's neighbourhood graph (PostGraph.astro, shown
 * only when another post shares a tag) and the related-post cards.
 *
 * The outline, tags and related posts are excluded from the Pagefind index so
 * search results quote the article text only.
 */
import { render } from "astro:content";
import RelatedPosts from "./RelatedPosts.astro";
import PostGraph from "./PostGraph.astro";
import {
  categorySlug,
  categoryHref,
  tagHref,
  type Post,
  type Lang,
} from "../utils/i18n";
import { categoryColor } from "../utils/categoryColor";

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const en = lang === "en";
const base = en ? "/en" : "";

const { Content, headings } = await render(post);

// Outline: h2 sections, numbered, with their h3s nested beneath.
let section = 0;
const outline = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({
    ...h,
    number: h.depth === 2 ? String(++section).padStart(2, "0") : null,
  }));

// Reading time: Chinese is counted per character, everything else per word.
const body = post.body ?? "";
const cjk = (body.match(/[㐀-鿿]/g) ?? []).length;
const words = (
  body.replace(/[㐀-鿿]/g, " ").match(/[A-Za-z0-9]+/g) ?? []
).length;
const minutes = Math.max(1, Math.round(cjk / 400 + words / 220));

const df = new Intl.DateTimeFormat(en ? "en" : "zh-TW", { dateStyle: "long" });
const published = df.format(post.data.publishedAt);
const updated = df.format(post.data.updatedAt);
const showUpdated =
  post.data.updatedAt.getTime() !== post.data.publishedAt.getTime();

const t = {
  hub: en ? "Knowledge hub" : "知識庫",
  updated: en ? `Updated ${updated}` : `更新於 ${updated}`,
  read: en ? `${minutes} min read` : `${minutes} 分鐘閱讀`,
  summary: en ? "Summary" : "摘要",
  outline: en ? "In this post" : "本文大綱",
  tags: en ? "Tags" : "標籤",
  back: en ? "All posts" : "所有文章",
};
---

<div class="progress" aria-hidden="true" style={`--c:${categoryColor(post.data.category)}`}>
  <div class="progress__bar" data-progress></div>
</div>

<article
  class="wrap post"
  style={`--c:${categoryColor(post.data.category)}`}
  data-pagefind-body
  data-pagefind-filter={`lang:${lang}`}
>
  <header class="post__head">
    <p class="post__crumb" data-pagefind-ignore>
      <a href={`${base}/posts/`}>{t.hub}</a>
      <span aria-hidden="true">/</span>
      <a class="post__cat" href={categoryHref(categorySlug(post), lang)}>
        <span class="post__dot" aria-hidden="true"></span>
        {post.data.category}
      </a>
    </p>
    <h1>{post.data.title}</h1>
    <p class="post__lede">{post.data.description}</p>
    <p class="post__meta" data-pagefind-ignore>
      <time datetime={post.data.publishedAt.toISOString()}>{published}</time>
      {showUpdated && <span>{t.updated}</span>}
      <span>{t.read}</span>
    </p>
    {
      post.data.tldr && (
        <aside class="post__tldr" aria-label={t.summary}>
          <p class="post__tldr-label">TL;DR</p>
          <p class="post__tldr-body">{post.data.tldr}</p>
        </aside>
      )
    }
  </header>

  {
    outline.length > 1 && (
      <nav class="outline" aria-label={t.outline} data-pagefind-ignore>
        <p class="outline__label">{t.outline}</p>
        <ol>
          {outline.map((h) => (
            <li class:list={{ "outline__sub": h.depth === 3 }}>
              <a href={`#${h.slug}`} data-outline={h.slug}>
                {h.number && <span class="outline__num">{h.number}</span>}
                <span>{h.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <div class="post__body prose" data-post-body>
    <Content />
  </div>

  <footer class="post__foot" data-pagefind-ignore>
    <p class="post__foot-label">{t.tags}</p>
    <ul class="post__tags">
      {
        post.data.tags.map((tag) => (
          <li>
            <a class="uwp-tag uwp-tag--outline" href={tagHref(tag, lang)}>
              #{tag}
            </a>
          </li>
        ))
      }
    </ul>
  </footer>
</article>

<div class="wrap">
  <PostGraph post={post} lang={lang} />
  <RelatedPosts post={post} lang={lang} />
  <p class="post__back">
    <a class="uwp-link" href={`${base}/posts/`}>
      <span aria-hidden="true">←</span> {t.back}
    </a>
  </p>
</div>

<script>
  (() => {
    const bodyEl = document.querySelector<HTMLElement>("[data-post-body]");
    const bar = document.querySelector<HTMLElement>("[data-progress]");
    if (!bodyEl) return;

    // Reading progress across the article body.
    if (bar) {
      let queued = false;
      const update = () => {
        queued = false;
        const rect = bodyEl.getBoundingClientRect();
        const total = rect.height - window.innerHeight * 0.6;
        const done = -rect.top + window.innerHeight * 0.4;
        const ratio = total > 0 ? Math.min(1, Math.max(0, done / total)) : 1;
        bar.style.transform = `scaleX(${ratio})`;
      };
      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      update();
    }

    // Mark the outline entry for the section currently being read.
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-outline]"),
    );
    if (!links.length) return;
    const targets = links
      .map((a) => document.getElementById(a.dataset.outline ?? ""))
      .filter((el): el is HTMLElement => !!el);

    const mark = () => {
      const line = window.innerHeight * 0.3;
      let current = targets[0];
      for (const el of targets) {
        if (el.getBoundingClientRect().top <= line) current = el;
      }
      for (const a of links) {
        const on = a.dataset.outline === current?.id;
        if (on) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
      }
    };
    let pending = false;
    window.addEventListener(
      "scroll",
      () => {
        if (pending) return;
        pending = true;
        requestAnimationFrame(() => {
          pending = false;
          mark();
        });
      },
      { passive: true },
    );
    mark();
  })();
</script>

<style>
  /* --- Reading progress --------------------------------------------------- */
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 50;
    pointer-events: none;
  }
  .progress__bar {
    height: 100%;
    background-color: var(--c);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* --- Page grid ---------------------------------------------------------- */
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--uwp-space-8);
    padding-block: var(--uwp-space-12) var(--uwp-space-8);
  }
  .post > * {
    min-width: 0;
  }

  /* --- Header ------------------------------------------------------------- */
  .post__crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--uwp-space-2);
    font-size: var(--uwp-text-sm);
    color: var(--uwp-color-text-subtle);
  }
  .post__crumb a {
    color: var(--uwp-color-text-muted);
    font-weight: var(--uwp-weight-medium);
  }
  .post__crumb a:hover {
    color: var(--uwp-color-text);
  }
  .post__cat {
    display: inline-flex;
    align-items: center;
    gap: var(--uwp-space-2);
  }
  .post__dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background-color: var(--c);
  }
  .post__head h1 {
    margin-top: var(--uwp-space-4);
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3rem);
    font-weight: var(--uwp-weight-bold);
    max-width: 22ch;
  }
  :global(html[lang="zh-Hant-TW"]) .post__head h1 {
    max-width: 18em;
  }
  .post__lede {
    margin-top: var(--uwp-space-4);
    font-size: var(--uwp-text-xl);
    line-height: var(--uwp-leading-normal);
    color: var(--uwp-color-text-muted);
    max-width: var(--uwp-measure);
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--uwp-space-1) var(--uwp-space-3);
    margin-top: var(--uwp-space-5);
    font-size: var(--uwp-text-sm);
    color: var(--uwp-color-text-subtle);
  }
  .post__meta > * + *::before {
    content: "·";
    margin-right: var(--uwp-space-3);
  }
  .post__tldr {
    margin-top: var(--uwp-space-8);
    padding: var(--uwp-space-5) var(--uwp-space-6);
    max-width: var(--uwp-measure);
    background-color: var(--uwp-color-surface);
    border: 1px solid var(--uwp-color-border-subtle);
    border-left: 3px solid var(--c);
    border-radius: var(--uwp-radius-md);
  }
  .post__tldr-label {
    margin-bottom: var(--uwp-space-2);
    font-size: var(--uwp-text-xs);
    font-weight: var(--uwp-weight-semibold);
    letter-spacing: var(--uwp-tracking-wide);
    color: var(--uwp-color-text-subtle);
  }
  .post__tldr-body {
    font-size: var(--uwp-text-lg);
    line-height: var(--uwp-leading-relaxed);
    color: var(--uwp-color-text);
  }

  /* --- Outline ------------------------------------------------------------ */
  .outline {
    padding: var(--uwp-space-5) var(--uwp-space-6);
    max-width: var(--uwp-measure);
    background-color: var(--uwp-color-surface);
    border: 1px solid var(--uwp-color-border-subtle);
    border-radius: var(--uwp-radius-md);
  }
  .outline__label {
    font-size: var(--uwp-text-xs);
    font-weight: var(--uwp-weight-semibold);
    letter-spacing: var(--uwp-tracking-wide);
    text-transform: uppercase;
    color: var(--uwp-color-text-subtle);
    margin-bottom: var(--uwp-space-3);
  }
  .outline ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--uwp-space-1);
  }
  .outline a {
    display: flex;
    gap: var(--uwp-space-3);
    padding: var(--uwp-space-1) 0;
    font-size: var(--uwp-text-sm);
    line-height: var(--uwp-leading-snug);
    color: var(--uwp-color-text-muted);
    text-decoration: none;
  }
  .outline a:hover {
    color: var(--uwp-color-text);
  }
  .outline a[aria-current] {
    color: var(--uwp-color-text);
    font-weight: var(--uwp-weight-medium);
  }
  .outline__num {
    flex-shrink: 0;
    font-family: var(--uwp-font-display);
    font-weight: var(--uwp-weight-bold);
    font-variant-numeric: tabular-nums;
    color: var(--uwp-color-text-subtle);
  }
  .outline a[aria-current] .outline__num {
    color: var(--c);
  }
  .outline__sub a {
    padding-left: calc(1.25rem + var(--uwp-space-3));
  }

  /* --- Article body ------------------------------------------------------- */
  .post__body {
    max-width: var(--uwp-measure);
    counter-reset: section;
    font-size: 1.0625rem;
    line-height: var(--uwp-leading-relaxed);
  }
  .post__body > :global(* + *) {
    margin-top: var(--uwp-space-5);
  }
  .post__body :global(h2) {
    counter-increment: section;
    margin-top: var(--uwp-space-16);
    padding-top: var(--uwp-space-6);
    border-top: 1px solid var(--uwp-color-border-subtle);
    font-size: var(--uwp-text-2xl);
    line-height: var(--uwp-leading-snug);
    scroll-margin-top: var(--uwp-space-8);
  }
  .post__body :global(h2)::before {
    content: counter(section, decimal-leading-zero);
    display: block;
    margin-bottom: var(--uwp-space-2);
    font-size: var(--uwp-text-sm);
    font-weight: var(--uwp-weight-bold);
    letter-spacing: var(--uwp-tracking-wide);
    color: var(--c);
  }
  .post__body :global(h3) {
    margin-top: var(--uwp-space-10);
    font-size: var(--uwp-text-xl);
    scroll-margin-top: var(--uwp-space-8);
  }
  .post__body :global(a) {
    color: var(--uwp-color-primary-emphasis);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .post__body :global(strong) {
    font-weight: var(--uwp-weight-bold);
    color: var(--uwp-color-text);
  }
  .post__body :global(blockquote) {
    margin-inline: 0;
    padding: var(--uwp-space-1) 0 var(--uwp-space-1) var(--uwp-space-5);
    border-left: 3px solid var(--c);
    font-size: var(--uwp-text-lg);
    color: var(--uwp-color-text-muted);
  }
  .post__body :global(img) {
    display: block;
    border-radius: var(--uwp-radius-md);
    border: 1px solid var(--uwp-color-border-subtle);
  }
  .post__body :global(hr) {
    border: 0;
    height: 1px;
    margin-block: var(--uwp-space-10);
    background-color: var(--uwp-color-border-subtle);
  }
  .post__body :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    font-family: var(--uwp-font-mono);
    font-size: 0.9em;
    background-color: var(--uwp-color-surface-sunken);
    border-radius: var(--uwp-radius-sm);
  }
  .post__body :global(pre) {
    padding: var(--uwp-space-4) var(--uwp-space-5);
    overflow-x: auto;
    font-size: var(--uwp-text-sm);
    line-height: var(--uwp-leading-normal);
    border: 1px solid var(--uwp-color-border-subtle);
    border-radius: var(--uwp-radius-md);
  }
  .post__body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--uwp-text-sm);
  }
  .post__body :global(th),
  .post__body :global(td) {
    padding: var(--uwp-space-2) var(--uwp-space-3);
    text-align: left;
    border-bottom: 1px solid var(--uwp-color-border-subtle);
  }
  .post__body :global(th) {
    color: var(--uwp-color-text-muted);
    font-weight: var(--uwp-weight-medium);
  }

  /* --- Footer ------------------------------------------------------------- */
  .post__foot {
    max-width: var(--uwp-measure);
    padding-top: var(--uwp-space-6);
    border-top: 1px solid var(--uwp-color-border-subtle);
  }
  .post__foot-label {
    font-size: var(--uwp-text-xs);
    font-weight: var(--uwp-weight-semibold);
    letter-spacing: var(--uwp-tracking-wide);
    text-transform: uppercase;
    color: var(--uwp-color-text-subtle);
    margin-bottom: var(--uwp-space-3);
  }
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--uwp-space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post__back {
    margin-top: var(--uwp-space-10);
    font-size: var(--uwp-text-sm);
  }

  /* --- Wide screens: outline becomes a sticky right-hand column ----------- */
  @media (min-width: 64rem) {
    .post {
      grid-template-columns: minmax(0, 1fr) 16rem;
      column-gap: var(--uwp-space-16);
      row-gap: var(--uwp-space-10);
    }
    .post__head {
      grid-column: 1 / -1;
    }
    .post__body,
    .post__foot {
      grid-column: 1;
    }
    .outline {
      grid-column: 2;
      grid-row: 2 / span 2;
      align-self: start;
      position: sticky;
      top: var(--uwp-space-8);
      padding: 0 0 0 var(--uwp-space-5);
      background: none;
      border: 0;
      border-left: 1px solid var(--uwp-color-border-subtle);
      border-radius: 0;
    }
  }
</style>
