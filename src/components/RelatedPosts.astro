---
/**
 * "Related posts" block for the foot of an article. Picks the most topically
 * similar posts in the same language via `getRelatedPosts` (shared tags, then
 * category, then recency) and renders them as cards. Each card shows the tags
 * it has in common with the current post, so the reason it is related is
 * visible. Sits OUTSIDE the article's `data-pagefind-body`, so these links
 * aren't indexed as article text. Renders nothing when there are no other posts
 * in the language.
 */
import {
  getRelatedPosts,
  postHref,
  type Post,
  type Lang,
} from "../utils/i18n";
import { categoryColor } from "../utils/categoryColor";

interface Props {
  post: Post;
  lang: Lang;
  limit?: number;
}

const { post, lang, limit = 3 } = Astro.props;
const related = await getRelatedPosts(post, limit);
const en = lang === "en";
const heading = en ? "Related posts" : "相關文章";
const sharedLabel = en ? "In common" : "共同標籤";
const df = new Intl.DateTimeFormat(en ? "en" : "zh-TW", { dateStyle: "long" });
const mine = new Set(post.data.tags);
---

{
  related.length > 0 && (
    <aside class="related" aria-labelledby="related-head">
      <h2 class="related__head" id="related-head">
        {heading}
      </h2>
      <ul class="related__list">
        {related.map((p) => {
          const shared = p.data.tags.filter((tag) => mine.has(tag));
          return (
            <li>
              <a
                class="related__card"
                href={postHref(p)}
                style={`--c:${categoryColor(p.data.category)}`}
              >
                <span class="related__meta">
                  <span class="related__dot" aria-hidden="true" />
                  <span>{p.data.category}</span>
                  <time datetime={p.data.publishedAt.toISOString()}>
                    {df.format(p.data.publishedAt)}
                  </time>
                </span>
                <span class="related__title">{p.data.title}</span>
                <span class="related__desc">{p.data.description}</span>
                {shared.length > 0 && (
                  <span class="related__shared">
                    {sharedLabel}: {shared.map((tag) => `#${tag}`).join(" ")}
                  </span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </aside>
  )
}

<style>
  .related {
    margin-top: var(--uwp-space-12);
    padding-top: var(--uwp-space-8);
    border-top: 1px solid var(--uwp-color-border-subtle);
  }
  .related__head {
    font-size: var(--uwp-text-sm);
    font-weight: var(--uwp-weight-medium);
    color: var(--uwp-color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--uwp-space-5);
  }
  .related__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--uwp-space-5);
  }
  .related__card {
    display: flex;
    flex-direction: column;
    gap: var(--uwp-space-2);
    height: 100%;
    padding: var(--uwp-space-5) var(--uwp-space-6);
    color: var(--uwp-color-text);
    text-decoration: none;
    background-color: var(--uwp-color-surface);
    border: 1px solid var(--uwp-color-border-subtle);
    border-top: 3px solid var(--c);
    border-radius: var(--uwp-radius-md);
    transition: border-color var(--uwp-transition), transform var(--uwp-transition);
  }
  .related__card:hover {
    border-color: var(--c);
    transform: translateY(-2px);
  }
  .related__card:focus-visible {
    outline: none;
    box-shadow: var(--uwp-shadow-focus);
  }
  .related__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--uwp-space-2);
    font-size: var(--uwp-text-xs);
    color: var(--uwp-color-text-subtle);
  }
  .related__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background-color: var(--c);
  }
  .related__title {
    font-family: var(--uwp-font-display);
    font-size: var(--uwp-text-lg);
    font-weight: var(--uwp-weight-heading);
    line-height: var(--uwp-leading-snug);
  }
  .related__desc {
    font-size: var(--uwp-text-sm);
    color: var(--uwp-color-text-muted);
  }
  .related__shared {
    margin-top: auto;
    padding-top: var(--uwp-space-2);
    font-size: var(--uwp-text-xs);
    color: var(--uwp-color-text-subtle);
  }
</style>
