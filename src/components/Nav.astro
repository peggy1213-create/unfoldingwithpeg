---
import LangSwitcher from "./LangSwitcher.astro";

interface Props {
  lang: "zh-TW" | "en";
  /** Language-neutral route, e.g. "/", "/about/", "/contact/". */
  route: string;
}

const { lang, route } = Astro.props;
const zh = lang === "zh-TW";

// Home of the current locale, and locale-prefixed page URLs.
const base = zh ? "" : "/en";
const home = zh ? "/" : "/en/";

// Primary nav — Home · Writing · About · Contact, then the language switch
// (max 5 items). Category and tag pages are reached from posts and the
// writing index, not from here.
const items = [
  { key: "/", href: home, label: zh ? "首頁" : "Home" },
  { key: "/writing/", href: `${base}/writing/`, label: zh ? "文章" : "Writing" },
  { key: "/about/", href: `${base}/about/`, label: zh ? "關於" : "About" },
  { key: "/contact/", href: `${base}/contact/`, label: zh ? "聯絡" : "Contact" },
];

const navLabel = zh ? "主導覽" : "Primary";
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-brand" href={home}>
      <img src="/assets/brand/mark.svg" alt="" />
      <span>Unfoldingwith<b>peg</b></span>
    </a>
    <nav class="site-nav" aria-label={navLabel}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={route === item.key ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LangSwitcher lang={lang} route={route} />
  </div>
</header>
