---
export const prerender = true;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import Search from "../../../components/Search.astro";
import TagFilter from "../../../components/TagFilter.astro";
import {
  getCategoryGroups,
  getTagGroups,
  getPostsByLang,
  categoryHref,
} from "../../../utils/i18n";

const lang = "en";
const groups = await getCategoryGroups(lang);
const tags = await getTagGroups(lang);

// Timeline view: all posts newest-first, grouped by publish year (newest first).
const posts = await getPostsByLang(lang);
const yearGroups = [
  ...posts
    .reduce((map, post) => {
      const year = post.data.publishedAt.getFullYear();
      (map.get(year) ?? map.set(year, []).get(year))!.push(post);
      return map;
    }, new Map<number, typeof posts>())
    .entries(),
].sort((a, b) => b[0] - a[0]);
---

<BaseLayout
  lang={lang}
  title="Knowledge hub — Peggy"
  description="Peggy's knowledge hub: a weekly piece unpacking AI, learning design, products, and tech. Search, or browse by topic."
>
  <div class="wrap wrap--prose" data-hub data-view="category">
    <Search lang={lang} />

    <nav class="browse" aria-label="Browse by category or tag">
      <div
        class="view-toggle"
        role="group"
        aria-label="Browse by"
        data-view-toggle
      >
        <button type="button" data-view-btn="category" aria-pressed="true">
          By category
        </button>
        <button type="button" data-view-btn="timeline" aria-pressed="false">
          By timeline
        </button>
      </div>

      <div class="browse__group" data-view-only="category">
        <ul class="chips">
          {
            groups.map((group) => (
              <li>
                <a
                  class="uwp-tag uwp-tag--blue"
                  href={categoryHref(group.slug, lang)}
                >
                  {group.name}
                  <span class="chips__count">{group.posts.length}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <TagFilter tags={tags} lang={lang} />
    </nav>

    <div data-view-panel="category">
      {
        groups.map((group) => (
          <section class="cat-group" data-group>
            <h2 class="cat-group__head">
              <a class="uwp-link" href={categoryHref(group.slug, lang)}>
                {group.name}
              </a>
              <span class="cat-group__count">
                {group.posts.length}{" "}
                {group.posts.length === 1 ? "post" : "posts"}
              </span>
            </h2>
            {group.posts.map((post) => (
              <PostCard post={post} lang={lang} />
            ))}
          </section>
        ))
      }
    </div>

    <div data-view-panel="timeline" hidden>
      {
        yearGroups.map(([year, yearPosts]) => (
          <section class="cat-group" data-group>
            <h2 class="cat-group__head">
              <span>{year}</span>
              <span class="cat-group__count">
                {yearPosts.length}{" "}
                {yearPosts.length === 1 ? "post" : "posts"}
              </span>
            </h2>
            {yearPosts.map((post) => (
              <PostCard post={post} lang={lang} showCategory />
            ))}
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  (() => {
    const hub = document.querySelector<HTMLElement>("[data-hub]");
    if (!hub) return;

    const btns = Array.from(
      hub.querySelectorAll<HTMLButtonElement>("[data-view-btn]"),
    );
    const panels = Array.from(
      hub.querySelectorAll<HTMLElement>("[data-view-panel]"),
    );
    const viewOnly = Array.from(
      hub.querySelectorAll<HTMLElement>("[data-view-only]"),
    );
    if (!btns.length) return;

    function setView(view: string) {
      hub!.dataset.view = view;
      for (const b of btns)
        b.setAttribute(
          "aria-pressed",
          b.dataset.viewBtn === view ? "true" : "false",
        );
      for (const p of panels) p.hidden = p.dataset.viewPanel !== view;
      for (const el of viewOnly) el.hidden = el.dataset.viewOnly !== view;
      // Let the tag filter re-scope to the now-visible panel.
      hub!.dispatchEvent(new CustomEvent("hub:viewchange"));
    }

    for (const b of btns)
      b.addEventListener("click", () => setView(b.dataset.viewBtn ?? "category"));
  })();
</script>

<style>
  .browse {
    margin-top: var(--uwp-space-8);
    padding-block: var(--uwp-space-6);
    border-bottom: 1px solid var(--uwp-color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--uwp-space-5);
  }
  .view-toggle {
    display: inline-flex;
    align-self: flex-start;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--uwp-color-border-subtle);
    border-radius: var(--uwp-radius-full, 999px);
    background: var(--uwp-color-surface-subtle, transparent);
  }
  .view-toggle button {
    appearance: none;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    font-size: var(--uwp-text-sm);
    color: var(--uwp-color-text-muted);
    padding: var(--uwp-space-1) var(--uwp-space-4);
    border-radius: var(--uwp-radius-full, 999px);
  }
  .view-toggle button[aria-pressed="true"] {
    background-color: var(--uwp-color-primary-soft);
    color: var(--uwp-color-primary-soft-text);
    font-weight: var(--uwp-weight-medium);
  }
  .browse__label {
    font-size: var(--uwp-text-sm);
    font-weight: var(--uwp-weight-medium);
    color: var(--uwp-color-text-subtle);
    margin-bottom: var(--uwp-space-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--uwp-space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .chips__count {
    color: var(--uwp-color-text-subtle);
    font-variant-numeric: tabular-nums;
  }
  .cat-group {
    margin-top: var(--uwp-space-10);
  }
  .cat-group__head {
    display: flex;
    align-items: baseline;
    gap: var(--uwp-space-3);
    font-size: var(--uwp-text-2xl);
  }
  .cat-group__count {
    font-size: var(--uwp-text-sm);
    font-weight: var(--uwp-weight-normal);
    color: var(--uwp-color-text-subtle);
  }
  /* While a tag filter is active the per-category counts are the full totals,
     which would misread next to a filtered subset — hide them. */
  [data-hub].is-filtering .cat-group__count {
    display: none;
  }
</style>
