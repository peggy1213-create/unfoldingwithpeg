---
export const prerender = true;

import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  getPostsByLang,
  postSlug,
  categorySlug,
  categoryHref,
  tagHref,
  type Post,
} from "../../../utils/i18n";

export async function getStaticPaths() {
  const posts = await getPostsByLang("en");
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);

const lang = "en";
const catSlug = categorySlug(post);

const df = new Intl.DateTimeFormat("en", { dateStyle: "long" });
const published = df.format(post.data.publishedAt);
const updated = df.format(post.data.updatedAt);
const showUpdated =
  post.data.updatedAt.getTime() !== post.data.publishedAt.getTime();
---

<BaseLayout lang="en" title={post.data.title} description={post.data.description}>
  <article class="wrap wrap--prose post">
    <header class="post__head">
      <p class="post__meta">
        <a class="uwp-tag uwp-tag--blue" href={categoryHref(catSlug, lang)}>
          {post.data.category}
        </a>
        <time datetime={post.data.publishedAt.toISOString()}>{published}</time>
        {showUpdated && <span class="post__updated">(updated {updated})</span>}
      </p>
      <h1>{post.data.title}</h1>
      {
        post.data.tldr ? (
          <aside class="post__tldr" aria-label="Summary">
            <p class="post__tldr-label">TL;DR</p>
            <p class="post__tldr-body">{post.data.tldr}</p>
          </aside>
        ) : (
          <p class="post__desc">{post.data.description}</p>
        )
      }
      <ul class="post__tags">
        {
          post.data.tags.map((t) => (
            <li>
              <a class="uwp-tag uwp-tag--outline" href={tagHref(t, lang)}>
                #{t}
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--uwp-space-12, 3rem);
  }
  .post__head {
    margin-bottom: var(--uwp-space-8, 2rem);
  }
  .post__meta {
    display: flex;
    align-items: center;
    gap: var(--uwp-space-3, 0.75rem);
    font-size: var(--uwp-text-sm, 0.875rem);
    color: var(--uwp-color-text-muted, #666);
  }
  .post__head h1 {
    margin-top: var(--uwp-space-4, 1rem);
  }
  .post__desc {
    color: var(--uwp-color-text-muted, #666);
    max-width: var(--uwp-measure);
  }
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--uwp-space-2, 0.5rem);
    list-style: none;
    padding: 0;
    margin-top: var(--uwp-space-4, 1rem);
  }
  .post__tldr {
    margin-top: var(--uwp-space-5, 1.25rem);
    padding: var(--uwp-space-4, 1rem) var(--uwp-space-5, 1.25rem);
    border-left: 3px solid var(--uwp-color-primary, #4f46e5);
    border-radius: var(--uwp-radius-md, 0.5rem);
    background-color: var(--uwp-color-surface-sunken, #f5f5f5);
    max-width: var(--uwp-measure);
  }
  .post__tldr-label {
    margin: 0 0 var(--uwp-space-1, 0.25rem);
    font-size: var(--uwp-text-xs, 0.75rem);
    font-weight: var(--uwp-weight-semibold);
    letter-spacing: var(--uwp-tracking-wide);
    text-transform: uppercase;
    color: var(--uwp-color-primary, #4f46e5);
  }
  .post__tldr-body {
    margin: 0;
    color: var(--uwp-color-text);
  }
</style>
