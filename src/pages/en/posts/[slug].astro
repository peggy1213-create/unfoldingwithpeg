---
export const prerender = true;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostView from "../../../components/PostView.astro";
import { getPostsByLang, postSlug, type Post } from "../../../utils/i18n";

export async function getStaticPaths() {
  const posts = await getPostsByLang("en");
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };

// BlogPosting structured data for this article. Author/publisher reference the
// site-wide Person node (@id) emitted by BaseLayout.
const site = Astro.site ?? new URL("https://studiounfolding.cc");
const articleLd = {
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  inLanguage: "en",
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: post.data.updatedAt.toISOString(),
  author: { "@id": `${site.origin}/#person` },
  publisher: { "@id": `${site.origin}/#person` },
  mainEntityOfPage: new URL(`/en/posts/${postSlug(post)}/`, site).href,
  articleSection: post.data.category,
  keywords: post.data.tags,
};
---

<BaseLayout
  lang="en"
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.publishedAt.toISOString()}
  modifiedTime={post.data.updatedAt.toISOString()}
  jsonLd={articleLd}
>
  <PostView post={post} lang="en" />
</BaseLayout>
