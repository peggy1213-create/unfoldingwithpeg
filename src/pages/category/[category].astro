---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCategoryGroups, type CategoryGroup } from "../../utils/i18n";

const lang = "zh-TW";

// One page per category that has ≥1 non-draft post in this language. Categories
// without posts are never generated, so their URLs 404 (no i18n fallback).
export async function getStaticPaths() {
  const groups = await getCategoryGroups("zh-TW");
  return groups.map((group) => ({
    params: { category: group.slug },
    props: { group },
  }));
}

const { group } = Astro.props as { group: CategoryGroup };
---

<BaseLayout
  lang={lang}
  title={`${group.name} — 文章 — 謝佩君 Peggy`}
  description={`謝佩君（Peggy）在「${group.name}」分類下的文章。`}
>
  <div class="wrap wrap--prose">
    <section class="section--tight">
      <p class="section__kicker">分類</p>
      <h1>{group.name}</h1>
      <p class="lede">{group.posts.length} 篇文章</p>
    </section>

    <div class="cat-list">
      {group.posts.map((post) => <PostCard post={post} lang={lang} />)}
    </div>

    <p class="back">
      <a class="uwp-link" href="/writing/">← 回到所有文章</a>
    </p>
  </div>
</BaseLayout>

<style>
  .lede {
    margin-top: var(--uwp-space-2);
    color: var(--uwp-color-text-muted);
  }
  .cat-list {
    margin-top: var(--uwp-space-8);
  }
  .back {
    margin-top: var(--uwp-space-10);
  }
</style>
