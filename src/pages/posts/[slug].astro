---
export const prerender = true;

import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getPostsByLang,
  getTranslation,
  postSlug,
  categorySlug,
  categoryHref,
  tagHref,
  type Post,
} from "../../utils/i18n";

export async function getStaticPaths() {
  const posts = await getPostsByLang("zh-TW");
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);

const lang = "zh-TW";
const catSlug = categorySlug(post);

// Counterpart in English, if this post is part of a translation pair.
const translation = await getTranslation(post);
const translationHref = translation
  ? `/en/posts/${postSlug(translation)}/`
  : null;

const df = new Intl.DateTimeFormat("zh-TW", { dateStyle: "long" });
const published = df.format(post.data.publishedAt);
const updated = df.format(post.data.updatedAt);
const showUpdated =
  post.data.updatedAt.getTime() !== post.data.publishedAt.getTime();
---

<BaseLayout lang="zh-TW" title={post.data.title} description={post.data.description}>
  <article class="wrap wrap--prose post">
    <header class="post__head">
      <p class="post__meta">
        <a class="uwp-tag uwp-tag--blue" href={categoryHref(catSlug, lang)}>
          {post.data.category}
        </a>
        <time datetime={post.data.publishedAt.toISOString()}>{published}</time>
        {showUpdated && <span class="post__updated">（更新於 {updated}）</span>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="post__desc">{post.data.description}</p>
      <ul class="post__tags">
        {
          post.data.tags.map((t) => (
            <li>
              <a class="uwp-tag uwp-tag--outline" href={tagHref(t, lang)}>
                #{t}
              </a>
            </li>
          ))
        }
      </ul>
      {
        translationHref && (
          <p class="post__translation">
            <span class="post__translation-label">其他語言：</span>
            <a class="uwp-link" href={translationHref} hreflang="en" lang="en">
              English
            </a>
          </p>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--uwp-space-12, 3rem);
  }
  .post__head {
    margin-bottom: var(--uwp-space-8, 2rem);
  }
  .post__meta {
    display: flex;
    align-items: center;
    gap: var(--uwp-space-3, 0.75rem);
    font-size: var(--uwp-text-sm, 0.875rem);
    color: var(--uwp-color-text-muted, #666);
  }
  .post__head h1 {
    margin-top: var(--uwp-space-4, 1rem);
  }
  .post__desc {
    color: var(--uwp-color-text-muted, #666);
    max-width: var(--uwp-measure);
  }
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--uwp-space-2, 0.5rem);
    list-style: none;
    padding: 0;
    margin-top: var(--uwp-space-4, 1rem);
  }
  .post__translation {
    margin-top: var(--uwp-space-4, 1rem);
  }
  .post__translation-label {
    color: var(--uwp-color-text-muted, #666);
    margin-right: var(--uwp-space-1, 0.25rem);
  }
</style>
