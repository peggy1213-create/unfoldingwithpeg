---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  /** "zh-TW" (default locale, no prefix) or "en" (served under /en/). */
  lang: "zh-TW" | "en";
  title: string;
  description: string;
  /** Open Graph object type. "article" for blog posts, else "website". */
  ogType?: "website" | "article";
  /** Absolute or root-relative path to a 1200×630 social-share image. */
  image?: string;
  /** ISO datetime — article publish time (article pages only). */
  publishedTime?: string;
  /** ISO datetime — article last-modified time (article pages only). */
  modifiedTime?: string;
  /**
   * Extra JSON-LD objects to embed (e.g. a BlogPosting or BreadcrumbList).
   * The site-identity WebSite + Person graph is always emitted in addition.
   */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  lang,
  title,
  description,
  ogType = "website",
  image,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;

// Derive the language-neutral route (e.g. "/", "/about/", "/contact/") from the
// current path, so the header/footer, hreflang alternates and the language
// switch all point at the right counterpart page regardless of locale.
const raw = Astro.url.pathname;
const stripped = raw.replace(/^\/en(?=\/|$)/, "") || "/";
const route = stripped.endsWith("/") ? stripped : stripped + "/";

const zhPath = route;
const enPath = route === "/" ? "/en/" : "/en" + route;
const htmlLang = lang === "zh-TW" ? "zh-Hant-TW" : "en";
const skip = lang === "zh-TW" ? "跳到主要內容" : "Skip to content";

// Absolute URLs (built against `site` in astro.config.mjs) for canonical,
// hreflang and Open Graph — crawlers and AI systems prefer absolute links.
const site = Astro.site ?? new URL("https://studiounfolding.cc");
const abs = (p: string) => new URL(p, site).href;
const canonical = abs(lang === "en" ? enPath : zhPath);
const zhUrl = abs(zhPath);
const enUrl = abs(enPath);
const ogImage = image ? abs(image) : undefined;
const ogLocale = lang === "zh-TW" ? "zh_TW" : "en_US";
const altLocale = lang === "zh-TW" ? "en_US" : "zh_TW";

// Site-identity structured data. A stable @id lets the Person be referenced as
// author from article pages, and sameAs links ground the identity for Google
// and generative-AI systems.
const personId = `${site.origin}/#person`;
const identityGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.origin}/#website`,
      url: `${site.origin}/`,
      name: "unfolding with Peg",
      inLanguage: ["zh-Hant-TW", "en"],
      publisher: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: "Peggy Pei-Chun Hsieh",
      alternateName: "謝佩君",
      url: `${site.origin}/`,
      jobTitle:
        lang === "zh-TW" ? "學習體驗設計師" : "Learning Experience Designer",
      description:
        lang === "zh-TW"
          ? "學習體驗設計師，為讓學習發生的人打造產品；目前在 TalentLabs。"
          : "Learning experience designer building products for the people who make learning happen; currently at TalentLabs.",
      worksFor: { "@type": "Organization", name: "TalentLabs" },
      knowsLanguage: ["zh-Hant", "en"],
      sameAs: [
        "https://www.linkedin.com/in/peggy-pei-chun-hsieh/",
        "https://github.com/peggy1213-create",
      ],
    },
  ],
};

const extraJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KBXF2CYC43"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KBXF2CYC43');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-Hant-TW" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="unfolding with Peg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={altLocale} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {
      ogType === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      ogType === "article" && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }

    <!-- Twitter / X card -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Structured data: site identity (WebSite + Person), plus any page-level
         JSON-LD (e.g. BlogPosting) passed by the route. -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(identityGraph)}
    />
    {
      extraJsonLd.map((obj) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({ "@context": "https://schema.org", ...obj })}
        />
      ))
    }
  </head>
  <body>
    <a class="skip-link uwp-link" href="#main">{skip}</a>

    <Nav lang={lang} route={route} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} route={route} />
  </body>
</html>
