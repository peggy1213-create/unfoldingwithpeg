{
	// Cloudflare Workers configuration for the unfoldingwithpeg site.
	// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
	//
	// The @astrojs/cloudflare adapter (via @cloudflare/vite-plugin) supplies the
	// Worker entry (`main`) and the static-assets binding automatically at build
	// time, so they are intentionally NOT set here.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "unfoldingwithpeg",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},

	// Custom Domains. Because studiounfolding.cc is already a zone in this
	// Cloudflare account, `custom_domain: true` makes Wrangler create the DNS
	// record and provision the TLS certificate automatically on deploy.
	"routes": [
		{ "pattern": "studiounfolding.cc", "custom_domain": true },
		{ "pattern": "www.studiounfolding.cc", "custom_domain": true }
	],
	// D1 database — job tracker
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "job-tracker-db",
			"database_id": "placeholder-replace-me"
		}
	]
}